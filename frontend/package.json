{
  "name": "arena3d",
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src e2e",
    "format": "prettier --write src e2e",
    "test": "vitest",
    "test:e2e": "playwright test",
    "help:shots": "HELP_SHOTS=1 playwright test e2e/help-shots.spec.ts --project=chromium"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bootstrap": "^5.2.11",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.0",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.11"
  }
}
